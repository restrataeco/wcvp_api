# Copy this file to .env and adjust for your setup.
# (The port is set on the uvicorn/gunicorn command line, not here.)
# Set a real secret here for production; required as X-Reload-Token header
# on POST /reload and POST /check-update.
RELOAD_TOKEN=change-me-to-a-real-secret

# Kew's zip with wcvp_names.csv + wcvp_distribution.csv. Checked every
# UPDATE_CHECK_HOURS; downloaded, extracted and rebuilt only when Kew publishes
# a new release.
WCVP_ZIP_URL=https://sftp.kew.org/pub/data-repositories/WCVP/wcvp.zip
UPDATE_CHECK_ENABLED=true
UPDATE_CHECK_HOURS=24

# Where the extracted CSVs and the database live. The defaults are fine.
CSV_PATH=data/wcvp_names.csv
DISTRIBUTION_CSV_PATH=data/wcvp_distribution.csv
DB_PATH=data/wcvp.db
# WCVP exports are pipe-delimited.
CSV_DELIMITER=|
