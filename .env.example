# Copy this file to .env and adjust for your setup.

# Path to your CSV. Update this whenever you download a new version from POWO,
# then call POST /reload (with the token below) to pick it up without restarting.
CSV_PATH=data/wcvp_names.csv
CSV_DELIMITER=,

# Pagination defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=500

# Set a real secret here for production; required as X-Reload-Token header on POST /reload.
RELOAD_TOKEN=change-me-to-a-real-secret

# Optional: comma-separated columns to search by default, e.g. taxon_name,genus,family
# Leave blank to search across every column.
DEFAULT_SEARCH_COLUMNS=
